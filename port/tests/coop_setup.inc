// Optional ROM-free extraction resources are generated by PORT_ROM_CLEAN.
static bool coop_file_present(const char* path)
{
    WIN32_FILE_ATTRIBUTE_DATA data;
    return GetFileAttributesExA(path, GetFileExInfoStandard, &data) &&
        !(data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) &&
        (data.nFileSizeHigh || data.nFileSizeLow);
}

static bool coop_assets_ready()
{
    const char* required[] = {
        "build/assets/files.tsv", "build/assets/handles.tsv", "build/assets/nitrofs.tsv",
        "build/assets/nitrofs_fnt.bin", "build/assets/nitrofs_fat.bin",
        "build/assets/nitrofs_ovt9.bin", "build/assets/romdata.bin",
        "build/assets/romdata.manifest", "extracted/dsd/files/data/sound_data.sdat"
    };
    const char* root = getenv("SM64DS_ASSET_ROOT");
    for (const char* name : required) {
        char path[2048];
        snprintf(path, sizeof path, "%s/%s", root ? root : ".", name);
        if (!coop_file_present(path)) return false;
    }
    return true;
}

static bool coop_write_resource(int id, const char* path)
{
    HRSRC resource = FindResourceA(0, MAKEINTRESOURCEA(id), MAKEINTRESOURCEA(10));
    if (!resource) return false;
    HGLOBAL loaded = LoadResource(0, resource);
    const void* bytes = loaded ? LockResource(loaded) : 0;
    DWORD size = SizeofResource(0, resource);
    if (!bytes || !size) return false;
    // Never replace a player's existing file with an embedded resource.
    HANDLE file = CreateFileA(path, GENERIC_WRITE, 0, 0, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, 0);
    if (file == INVALID_HANDLE_VALUE) return false;
    DWORD written = 0;
    bool ok = WriteFile(file, bytes, size, &written, 0) && written == size;
    CloseHandle(file);
    if (!ok) DeleteFileA(path);
    return ok;
}

static bool coop_setup_assets(ntr::Framebuffer& fb)
{
    if (coop_assets_ready()) return true;
    const char* root = getenv("SM64DS_ASSET_ROOT");
    if (!root) root = ".";
    char script[2048], recipe[2048], manifest[2048], log[2048];
    snprintf(script, sizeof script, "%s/coop-setup-%lu.ps1", root, GetCurrentProcessId());
    snprintf(recipe, sizeof recipe, "%s/romdata.recipe.tsv", root);
    snprintf(manifest, sizeof manifest, "%s/romdata.manifest", root);
    snprintf(log, sizeof log, "%s/extraction.log", root);
    bool made_recipe = !coop_file_present(recipe) && coop_write_resource(311, recipe);
    bool made_manifest = !coop_file_present(manifest) && coop_write_resource(312, manifest);
    bool made_script = coop_write_resource(310, script);
    bool ok = false;
    if (made_script && coop_file_present(recipe) && coop_file_present(manifest)) {
        char powershell[MAX_PATH], command[8192];
        UINT count = GetSystemDirectoryA(powershell, sizeof powershell);
        if (count && count + 48 < sizeof powershell) {
            strcat(powershell, "\\WindowsPowerShell\\v1.0\\powershell.exe");
            snprintf(command, sizeof command,
                "\"%s\" -NoProfile -NonInteractive -File \"%s\" -Destination \"%s\"",
                powershell, script, root);
            SECURITY_ATTRIBUTES security = { sizeof security, 0, TRUE };
            HANDLE output = CreateFileA(log, GENERIC_WRITE, FILE_SHARE_READ,
                &security, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, 0);
            HANDLE input = CreateFileA("NUL", GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE,
                &security, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, 0);
            if (output != INVALID_HANDLE_VALUE && input != INVALID_HANDLE_VALUE) {
                STARTUPINFOA si = {}; si.cb = sizeof si;
                si.dwFlags = STARTF_USESTDHANDLES | STARTF_USESHOWWINDOW;
                si.wShowWindow = SW_HIDE;
                si.hStdOutput = si.hStdError = output; si.hStdInput = input;
                PROCESS_INFORMATION pi = {};
                if (CreateProcessA(powershell, command, 0, 0, TRUE, CREATE_NO_WINDOW,
                                   0, root, &si, &pi)) {
                    unsigned frame = 0;
                    bool cancelled = false;
                    while (WaitForSingleObject(pi.hProcess, 16) == WAIT_TIMEOUT) {
                        MSG msg;
                        while (W.PeekMessageA_(&msg, 0, 0, 0, PM_REMOVE)) {
                            if (msg.message == WM_QUIT) cancelled = true;
                            W.TranslateMessage_(&msg); W.DispatchMessageA_(&msg);
                        }
                        if (cancelled) {
                            TerminateProcess(pi.hProcess, 1);
                            WaitForSingleObject(pi.hProcess, INFINITE);
                            W.PostQuitMessage_(0);
                            break;
                        }
                        coop_draw(fb, frame++, "IMPORTING YOUR CARTRIDGE"); present();
                    }
                    DWORD result = 1; GetExitCodeProcess(pi.hProcess, &result);
                    ok = !cancelled && result == 0 && coop_assets_ready();
                    CloseHandle(pi.hThread); CloseHandle(pi.hProcess);
                }
            }
            if (output != INVALID_HANDLE_VALUE) CloseHandle(output);
            if (input != INVALID_HANDLE_VALUE) CloseHandle(input);
        }
    }
    if (made_script) DeleteFileA(script);
    if (made_recipe) DeleteFileA(recipe);
    if (made_manifest) DeleteFileA(manifest);
    if (!ok) snprintf(g_coop_menu.message, sizeof g_coop_menu.message,
        "Put your .nds beside the game; retry. See extraction.log.");
    return ok;
}
